    ActiveDropdown = ViewStatsTab:AddDropdown("Select Player", function(selectedName)
        if selectedName == "None" or not selectedName then
            TargetPlayer = nil
            TargetInitialStats = {}
        else
            TargetPlayer = Players:FindFirstChild(selectedName)
            GetTargetInitialStats()
        end
    end)
    
    -- Add the functional option items using clean library strings
    ActiveDropdown:Add("None")
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then 
            ActiveDropdown:Add(p.Name) 
        end
    end
end

-- Run initialization population
PopulateDropdown()

-- Listen to player connections to force redraw list elements cleanly
Players.PlayerAdded:Connect(PopulateDropdown)
Players.PlayerRemoving:Connect(function(plr)
    if TargetPlayer == plr then
        TargetPlayer = nil
        TargetInitialStats = {}
    end
    PopulateDropdown()
end)

