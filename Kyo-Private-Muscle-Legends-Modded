local function SafeGetStat(player, name)
    if not player then return 0 end
    local ls = player:FindFirstChild("leaderstats")
    
    -- Check exact match, lowercase match, and leaderstats variants
    local stat = (ls and ls:FindFirstChild(name)) 
        or (ls and ls:FindFirstChild(name:lower()))
        or player:FindFirstChild(name) 
        or player:FindFirstChild(name:lower())
        
    -- Handle special casing for camelCase setups (e.g., evilKarma / goodKarma)
    if not stat and (name == "EvilKarma" or name == "GoodKarma") then
        local camelCase = name:sub(1,1):lower() .. name:sub(2)
        stat = player:FindFirstChild(camelCase) or (ls and ls:FindFirstChild(camelCase))
    end
    
    return stat and stat.Value or 0
end

